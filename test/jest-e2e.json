{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@nestjs/swagger$": "<rootDir>/support/nestjs-swagger.mock.ts"
  },
  "testTimeout": 30000,
  "maxWorkers": 1
}
